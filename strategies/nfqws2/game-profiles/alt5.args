--filter-tcp=1024-65535
--ipset=/opt/etc/nfqws2/lists/ipset.list
--ipset-exclude=/opt/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/opt/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=<n4
--payload=empty
--lua-desync=syndata:repeats=1
--payload=known,unknown
--lua-desync=multidisorder_legacy:payload=~empty
--new
--filter-udp=1024-65535
--ipset=/opt/etc/nfqws2/lists/ipset.list
--ipset-exclude=/opt/etc/nfqws2/lists/ipset_exclude.list
--ipset-exclude=/opt/etc/nfqws2/lists/ipset_exclude-extra.list
--out-range=<n3
--payload=quic_initial
--lua-desync=fake:blob=legacy_quic:repeats=14
--payload=discord_ip_discovery
--lua-desync=fake:blob=legacy_zero64:repeats=14
--payload=stun
--lua-desync=fake:blob=legacy_zero64:repeats=14
--payload=wireguard_initiation
--lua-desync=fake:blob=legacy_zero64:repeats=14
--payload=dht
--lua-desync=fake:blob=legacy_zero64:repeats=14
--payload=unknown
--lua-desync=fake:blob=ACTIVE_GAME_UDP:repeats=14:payload=~empty
